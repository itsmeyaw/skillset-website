---
import { agents } from "../components/agents";
import CommandLine from "../components/CommandLine.astro";
import Terminal, { type Line } from "../components/Terminal.astro";
import Layout from "../layouts/Layout.astro";

const install = "npm install -g @itsmeyaw/skillset";
const github = "https://github.com/itsmeyaw/skillset";
const npm = "https://www.npmjs.com/package/@itsmeyaw/skillset";

const projects = ["api", "web", "docs"];

const without: Line[] = projects.flatMap((name) => [
  { cmd: `cd ~/projects/${name}` },
  { cmd: "npx skills add mattpocock/skills --skill grilling tdd" },
  { cmd: "npx skills add juliusbrussee/caveman --skill caveman" },
]);

const withSkillset: Line[] = projects.flatMap((name) => [
  { cmd: `cd ~/projects/${name}` },
  { cmd: "skillset install my-set" },
]);

// Output below is copied from real runs of skillset 0.3.0.
const build: Line[] = [
  { cmd: "skillset add mattpocock/skills -s grilling -s tdd --set my-set" },
  { out: "Added grilling, tdd to /Users/you/.skillset/my-set.json" },
  { cmd: "skillset add juliusbrussee/caveman -s caveman --set my-set" },
  { out: "Added caveman to /Users/you/.skillset/my-set.json" },
  { cmd: "skillset ls --set my-set" },
  { out: "caveman  juliusbrussee/caveman  9b24366" },
  { out: "grilling  mattpocock/skills  5863806" },
  { out: "tdd  mattpocock/skills  5863806" },
];

const use: Line[] = [
  { cmd: "cd ~/projects/some-project" },
  { cmd: "skillset install my-set -y" },
  { out: "Installed caveman, grilling, tdd" },
  { cmd: "ls .agents/skills" },
  { out: "caveman  grilling  tdd" },
  { cmd: "ls" },
  { out: "skills-lock.json" },
];

// Descriptions are the real SKILL.md ones; bar widths come from their lengths.
const session = [
  {
    label: "3 skills for this task",
    short: "Needed",
    skills: [
      {
        name: "tdd",
        description:
          "Test-driven development. Use when the user wants to build features or fix bugs test-first, mentions “red-green-refactor”, or wants integration tests.",
      },
      {
        name: "grilling",
        description:
          "Grill the user relentlessly about a plan, decision, or idea. Use when the user wants to stress-test their thinking, or uses any ‘grill’ trigger phrases.",
      },
      {
        name: "caveman",
        description:
          "Terse caveman voice: answer first, fluff gone, every technical fact kept. Use for /caveman, “caveman mode”, “talk like caveman”, “be brief”, “less tokens”. Stays on until “stop caveman” or “normal mode”.",
      },
    ],
  },
  {
    label: "4 UI skills, loaded but not needed",
    short: "Not needed",
    unused: true,
    skills: [
      {
        name: "frontend-design",
        description:
          "Guidance for distinctive, intentional visual design when building new UI or reshaping an existing one. Helps with aesthetic direction, typography, and making choices that don’t read as templated defaults.",
      },
      {
        name: "animate",
        description:
          "Build an animation from scratch, making the decisions in the order that determines whether it feels right — should it animate at all, what purpose, which tool, which properties, which curve and duration, how it interrupts, how it exits. Writes the implementation. Use when asked to animate something, add motion, make a component feel alive, or build a transition. For critiquing existing motion use review-animations; for auditing a whole codebase use improve-animations.",
      },
      {
        name: "better-typography",
        description:
          "Sets and reviews how text renders, from the type scale and spacing to font features, wrapping, truncation and punctuation.",
      },
      {
        name: "better-layout",
        description:
          "Sets grouping, alignment, reading order, responsive structure and room for translated text, so a layout holds up when it is resized, translated or mirrored.",
      },
    ],
  },
].map((group) => ({
  ...group,
  chars: group.skills.reduce((sum, { description }) => sum + description.length, 0),
}));
const sessionChars = session.reduce((sum, { chars }) => sum + chars, 0);

const entry = (name: string, source: string, commit: string, last = false): Line[] => [
  { out: "    {" },
  { out: `      "name": "${name}",` },
  { out: `      "source": "${source}",` },
  { out: `      "commit": "${commit}"`, mark: commit },
  { out: last ? "    }" : "    }," },
];

const file: Line[] = [
  { out: "{" },
  {
    out: '  "$schema": "https://raw.githubusercontent.com/itsmeyaw/skillset/main/schemas/skillset/v1.json",',
  },
  { out: '  "skills": [' },
  ...entry("caveman", "juliusbrussee/caveman", "9b243662ff98d392bc0a95b865a554583d71be75"),
  ...entry("grilling", "mattpocock/skills", "5863806dd4e15c63174bee4e7515a4256792ecfa"),
  ...entry("tdd", "mattpocock/skills", "5863806dd4e15c63174bee4e7515a4256792ecfa", true),
  { out: "  ]" },
  { out: "}" },
];

const wrap = "mx-auto w-full max-w-300 px-6 sm:px-8 lg:px-12";
const navLink =
  "inline-flex min-h-11 items-center text-small text-text-secondary hover:text-text-primary";
const textLink =
  "text-text-primary underline decoration-border-strong underline-offset-4 hover:decoration-accent-text";
---

<Layout
  title="Skillset: one pinned list of agent skills for every project"
  description="Skillset is a CLI that keeps your agent skills in one list, pinned to exact Git commits, and installs it into any project with one command."
>
  <div
    aria-hidden="true"
    class="grain-glow pointer-events-none absolute inset-x-0 top-0 -z-10 h-[min(100svh,56rem)]"
  ></div>
  <header class:list={[wrap, "flex h-18 items-center justify-between gap-6"]}>
    <a href="/" class="inline-flex min-h-11 items-center text-heading">
      Skillset
    </a>
    <nav aria-label="Main" class="flex items-center gap-8">
      <a href={github} class={navLink}>
        GitHub
      </a>
    </nav>
  </header>

  <main id="main">
    <section
      class:list={[
        wrap,
        "flex flex-col justify-center py-14 lg:min-h-[min(calc(100svh-4.5rem),54rem)] lg:py-20",
      ]}
    >
      <h1 class="text-balance text-display" data-enter>
        Next generation agent skills management
      </h1>

      <p class="mt-6 max-w-2xl text-pretty text-lead text-text-muted" data-enter>
        Skillset CLI makes it easier for you to manage all your agent skills for all your projects.
      </p>

      <div class="mt-10 max-w-200" data-enter>
        <CommandLine command={install} primary />
        <p class="mt-3 text-small text-text-muted">
          Or try it first with <code>npx @itsmeyaw/skillset --help</code>.
        </p>
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-3 lg:mt-14" data-enter>
        <p id="agents-label" class="text-small text-text-muted">
          Works with these agents:
        </p>
        <ul
          aria-labelledby="agents-label"
          class="flex flex-wrap items-center gap-x-4 gap-y-2 text-text-primary"
        >
          {agents.map(({ name, paths }) => (
            <li data-agent class="opacity-40">
              <svg
                role="img"
                aria-label={name}
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <title>{name}</title>
                {paths.map((d) => (
                  <path d={d} fill-rule="evenodd" />
                ))}
              </svg>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="why" class:list={[wrap, "py-20 lg:py-24"]}>
      <h2 class="max-w-[24ch] text-balance text-title">Stop reinstalling skills</h2>
      <p class="mt-6 max-w-[50ch] text-pretty text-lead text-text-secondary">
        In each project you run <code>npx skills add</code> for every source, pick the same skills
        again, and get whatever commit is latest that day.
      </p>

      <div class="mt-12 grid items-start gap-6 lg:grid-cols-2 lg:gap-8">
        <Terminal
          title="Without Skillset"
          lines={without}
          class="order-1 lg:order-none"
          data-fade-out
        >
          6 installs, each at whatever commit is latest.
        </Terminal>
        <div class="contents lg:block">
          <Terminal
            title="With Skillset"
            lines={withSkillset}
            class="order-3 lg:order-none"
            data-fade-in
          >
            3 installs, each at the pinned commits
            <span class="font-mono text-accent-text">9b24366</span> and
            <span class="font-mono text-accent-text">5863806</span>.
          </Terminal>
          <p class="order-2 max-w-[62ch] text-pretty text-text-secondary lg:order-none lg:mt-6">
            A Skillset records that routine once: each skill, its repository and its commit. Every
            project then needs one command.
          </p>
        </div>
      </div>
    </section>

    <section id="context" class:list={[wrap, "py-20 lg:py-24"]}>
      <h2 class="max-w-[24ch] text-balance text-title">Each project built differently</h2>
      <p class="mt-6 max-w-[50ch] text-pretty text-lead text-text-secondary">
        Global skills are nice, but they are not always useful and take space in your agent context.
      </p>

      <figure class="mt-12 overflow-hidden rounded-sm border border-border bg-bg-surface">
        <figcaption class="border-b border-border-separator px-4 py-2.5 font-mono text-small text-text-muted sm:px-6">
          Agent session without Skillset
        </figcaption>
        <div class="p-4 sm:p-6">
          <p class="text-small text-text-muted">Task</p>
          <p class="mt-1 font-mono text-code text-text-primary">
            Add rate limiting to POST /orders
          </p>
          {session.map(({ label, skills, unused }) => (
            <div class="mt-8">
              <p class="text-small text-text-muted">{label}</p>
              <dl class:list={["mt-3 grid gap-y-4", { "opacity-70": unused }]} data-unused={unused}>
                {skills.map(({ name, description }) => (
                  <div class="grid gap-x-8 gap-y-1 sm:grid-cols-[11rem_minmax(0,1fr)]">
                    <dt class="font-mono text-code text-text-primary">{name}</dt>
                    <dd class="text-pretty text-small text-text-secondary">{description}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
        <div class="border-t border-border-separator px-4 py-4 sm:px-6">
          <p class="text-small text-text-secondary">
            Share of skill descriptions loaded, by length
          </p>
          <div
            class="mt-3 grid gap-x-0.5"
            style={`grid-template-columns: ${session.map(({ chars }) => `minmax(0, ${chars}fr)`).join(" ")}`}
          >
            {session.map(({ short, skills, chars, unused }) => (
              <div>
                <div aria-hidden="true" class="flex h-2 gap-0.5">
                  {skills.map(({ description }) => (
                    <span
                      class:list={[
                        "rounded-[1px]",
                        unused ? "bg-border-strong" : "bg-accent-solid",
                      ]}
                      style={`flex: ${description.length} 1 0`}
                    />
                  ))}
                </div>
                <p class="mt-2 text-small tabular-nums text-text-muted">
                  {short} {Math.round((100 * chars) / sessionChars)}%
                </p>
              </div>
            ))}
          </div>
        </div>
      </figure>
    </section>

    <section id="how" class:list={[wrap, "py-20 lg:py-24"]}>
      <h2 class="max-w-[24ch] text-balance text-title">Two steps are all you need</h2>

      <div class="mt-12 grid gap-y-16 lg:grid-cols-2 lg:gap-x-8 lg:gap-y-5">
        <div class="grid gap-y-5 lg:row-span-4 lg:grid-rows-subgrid">
          <h3 class="text-heading">
            <span
              aria-hidden="true"
              class="mb-4 flex size-9 items-center justify-center rounded-full border border-text-primary/30 bg-[rgb(255_255_255/0.05)] font-mono text-sm tabular-nums text-text-primary"
            >
              1
            </span>
            Build your Skillset
          </h3>
          <p class="max-w-[62ch] text-pretty text-text-secondary">
            Add all your favorite skills for a single work type.
          </p>
          <CommandLine command="skillset add --set my-set" />
          <Terminal title="Any directory" lines={build} class="lg:self-start" />
        </div>
        <div class="grid gap-y-5 lg:row-span-4 lg:grid-rows-subgrid">
          <h3 class="text-heading">
            <span
              aria-hidden="true"
              class="mb-4 flex size-9 items-center justify-center rounded-full border border-text-primary/30 bg-[rgb(255_255_255/0.05)] font-mono text-sm tabular-nums text-text-primary"
            >
              2
            </span>
            Install it in a project
          </h3>
          <p class="max-w-[62ch] text-pretty text-text-secondary">
            Install the exact same skill for all your projects.
          </p>
          <CommandLine command="skillset install my-set" />
          <Terminal title="~/projects/some-project" lines={use} class="lg:self-start" />
        </div>
      </div>
    </section>

    <section id="pins" class:list={[wrap, "py-20 lg:py-24"]}>
      <div class="grid items-start gap-x-8 gap-y-12 lg:grid-cols-2">
        <div>
          <h2 class="text-balance text-title">No surprise added</h2>
          <p class="mt-6 max-w-[50ch] text-pretty text-lead text-text-secondary">
            Skillset saves the Git commit each skill came from. Every install gets those same
            commits, today or six months from now, until you run <code>skillset update</code>.
          </p>
          <div class="mt-8">
            <CommandLine command="skillset update --set my-set" />
          </div>

          <h3 class="mt-16 text-heading">Collaboration in-mind</h3>
          <p class="mt-4 max-w-[62ch] text-pretty text-text-secondary">
            A Skillset file is nothing more than a JSON file. Put it in a remote repository or
            anywhere on the internet, and teammates run <code>skillset install</code> to get the
            same skills at the same commits.
          </p>
          <div class="mt-8">
            <CommandLine command="skillset install https://example.com/team.json" />
          </div>
        </div>
        <Terminal title="~/.skillset/my-set.json" lines={file} />
      </div>
    </section>

    <section id="details" class:list={[wrap, "py-20 lg:py-24"]}>
      <div class="grid gap-x-8 gap-y-10 lg:grid-cols-2">
        <div>
          <h2 class="text-balance text-title">Fits your setup</h2>
          <p class="mt-6 max-w-[50ch] text-pretty text-lead text-text-secondary">
            Skillset wraps{" "}
            <a href="https://skills.sh" class={textLink}>
              Vercel’s Skills CLI
            </a>
            , so it works with the agents, sources and lockfile you use today.
          </p>
        </div>
        <dl class="border-b border-border-separator">
          {[
            {
              term: "Your agents",
              text: "Installs for Universal agents (<code>.agents/skills</code>), Claude Code and any agent it detects, or only the ones you name with <code>-a</code>.",
            },
            {
              term: "Your sources",
              text: "Takes <code>owner/repo</code>, a branch, a tag or a full commit SHA, GitHub tree URLs and other Git URLs. Private repositories use your existing Git credentials.",
            },
            {
              term: "Your scripts",
              text: "Commands prompt by default. Pass flags and <code>-y</code> to run unattended.",
            },
            {
              term: "Your choice of scope",
              text: "Install per project or globally, as symlinks or copies.",
            },
          ].map(({ term, text }) => (
            <div class="grid gap-x-8 gap-y-1 border-t border-border-separator py-5 sm:grid-cols-[11rem_minmax(0,1fr)]">
              <dt class="font-medium">{term}</dt>
              <dd class="text-pretty text-text-secondary" set:html={text} />
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="install" class="relative border-t border-border-separator">
      <div
        aria-hidden="true"
        class="grain-glow pointer-events-none absolute inset-0 -z-10 [--glow-at:50%_115%]"
      ></div>
      <div class:list={[wrap, "py-20 lg:py-24"]}>
        <h2 class="text-balance text-title">Install Skillset</h2>
        <p class="mt-6 max-w-[50ch] text-pretty text-lead text-text-secondary">
          Install the CLI with npm, then run <code>skillset add --set my-set</code> to build your
          first list.
        </p>
        <div class="mt-10 max-w-200">
          <CommandLine command={install} primary />
        </div>
        <p class="mt-6 flex flex-wrap gap-x-8 gap-y-2">
          <a href={`${github}#readme`} class:list={[textLink, "inline-flex min-h-11 items-center"]}>
            Read the docs on GitHub
          </a>
          <a href={npm} class:list={[textLink, "inline-flex min-h-11 items-center"]}>
            View the package on npm
          </a>
        </p>
      </div>
    </section>
  </main>

  <footer class="border-t border-border-separator">
    <div
      class:list={[
        wrap,
        "flex flex-wrap justify-between gap-x-8 gap-y-2 py-8 text-small text-text-muted",
      ]}
    >
      <p>© 2026 Yudhistira Arief Wibowo</p>
      <p>Skillset is MIT licensed.</p>
    </div>
  </footer>
</Layout>

<script>
  import { animate, hover, scroll, stagger } from "motion";

  const ease = [0.23, 1, 0.32, 1] as const;

  // Icons stay translucent at rest and on hover, so the hover only firms them up.
  const quick = matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 0.2;
  hover("[data-agent]", (el) => {
    animate(el, { opacity: 0.75 }, { duration: quick, ease });
    return () => animate(el, { opacity: 0.4 }, { duration: quick, ease });
  });

  // Nothing below runs with reduced motion, because every state is already readable without it.
  // It also stays off once the 0.8s fallback in Layout has shown the hero, so a late script can't hide it again.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce && document.documentElement.classList.contains("js")) {
    animate(
      "[data-enter]",
      { opacity: [0, 1], y: [12, 0] },
      { duration: 0.5, ease, delay: stagger(0.06) },
    );

    // Dims the repeated installs and brightens the single command as the comparison scrolls past.
    // 0.6 keeps the dimmed lines readable (5.69:1 against the terminal surface).
    const handOff = (selector: string, opacity: [number, number]) => {
      const output = document.querySelector(selector);
      if (!output) return;
      scroll(animate(output, { opacity }, { ease: "linear" }), {
        target: output,
        offset: ["start 0.8", "start 0.3"],
      });
    };
    handOff("[data-fade-out] pre", [1, 0.6]);
    handOff("[data-fade-in] pre", [0.6, 1]);
    // The UI skills a backend agent loads anyway. Their smaller grey descriptions need 0.7 to stay at 4.78:1.
    handOff("[data-unused]", [1, 0.7]);
  }
</script>
