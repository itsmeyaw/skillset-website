---
// The Skillset mark, copied from the CLI repository's assets/skillset.svg.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg aria-hidden="true" viewBox="0 0 67 58" class={className}>
  <rect width="26" height="26" rx="7" fill="#2A5BC9"></rect>
  <rect x="32" width="26" height="26" rx="7" fill="#3B7BFF"></rect>
  <rect y="32" width="26" height="26" rx="7" fill="#3B7BFF"></rect>
  <rect
    x="38"
    y="26"
    width="26"
    height="26"
    rx="7"
    fill="#B5CEFF"
    transform="rotate(-12 51 39)"
  ></rect>
</svg>
