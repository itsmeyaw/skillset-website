{
  "name": "skillset-website",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky",
    "deploy": "wrangler deploy",
    "check": "astro check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "motion": "^14.14.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.163.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@11.20.0"
}
